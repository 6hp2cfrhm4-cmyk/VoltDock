<Window x:Class="VoltDock.App.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VoltDock.App.Views"
        xmlns:vm="clr-namespace:VoltDock.App.ViewModels"
        xmlns:controls="clr-namespace:VoltDock.UI.Controls;assembly=VoltDock.UI"
        mc:Ignorable="d"
        Title="VoltDock" 
        Height="60" Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        Deactivated="Window_Deactivated">
    
    <Window.DataContext>
        <vm:DockViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VoltDock.UI;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Battery Level to Color Converter -->
            <local:BatteryLevelToColorConverter x:Key="BatteryLevelToColorConverter"/>
            <local:BatteryLevelToWidthConverter x:Key="BatteryLevelToWidthConverter"/>
            <local:ChargeStateToVisibilityConverter x:Key="ChargeStateToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="DockBorder"
            Background="{DynamicResource DockBackgroundBrush}"
            CornerRadius="{Binding CornerRadius}"
            BorderBrush="{DynamicResource DockBorderBrush}"
            BorderThickness="1"
            Effect="{DynamicResource DockShadowEffect}"
            Padding="12,8">
        
        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.2"
                                         EasingFunction="{DynamicResource StandardEasing}"/>
                        <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.Y)"
                                         From="10" To="0" Duration="0:0:0.3"
                                         EasingFunction="{DynamicResource StandardEasing}"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        
        <Border.RenderTransform>
            <TranslateTransform/>
        </Border.RenderTransform>

        <ItemsControl x:Name="DevicesItemsControl"
                      ItemsSource="{Binding Devices}"
                      VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="DeviceItem"
                            Margin="4,0"
                            Padding="10,6"
                            Background="{DynamicResource DeviceItemBackgroundBrush}"
                            CornerRadius="12"
                            BorderBrush="{DynamicResource DeviceItemBorderBrush}"
                            BorderThickness="1"
                            ToolTip="{Binding ToolTipText}"
                            MouseEnter="DeviceItem_MouseEnter"
                            MouseLeave="DeviceItem_MouseLeave">
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Device Icon -->
                            <Image Grid.Column="0"
                                   Source="{Binding IconSource}"
                                   Width="{Binding IconSize}" 
                                   Height="{Binding IconSize}"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <!-- Battery Indicator -->
                            <Grid Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding ShowBatteryIndicator, Converter={StaticResource BoolToVisibilityConverter}}"
                                  Margin="0,0,8,0">
                                <Border Width="40" Height="6"
                                        Background="{DynamicResource BatteryTrackBrush}"
                                        CornerRadius="3"
                                        VerticalAlignment="Center">
                                    <Border Width="{Binding BatteryLevel, Converter={StaticResource BatteryLevelToWidthConverter}, ConverterParameter=40}"
                                            Height="6"
                                            Background="{Binding BatteryLevel, Converter={StaticResource BatteryLevelToColorConverter}}"
                                            CornerRadius="3"
                                            HorizontalAlignment="Left">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="0" CenterX="0"/>
                                        </Border.RenderTransform>
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="Border.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         From="0" To="1" Duration="0:0:0.4"
                                                                         EasingFunction="{DynamicResource StandardEasing}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                    </Border>
                                </Border>
                                
                                <!-- Charging Animation -->
                                <Border x:Name="ChargingAnimation"
                                        Width="40" Height="6"
                                        Visibility="{Binding ChargeState, Converter={StaticResource ChargeStateToVisibilityConverter}}"
                                        VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0.5"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Border.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.X)"
                                                                     From="-40" To="40" Duration="0:0:1.5"
                                                                     EasingFunction="{DynamicResource StandardEasing}"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                    <Border.RenderTransform>
                                        <TranslateTransform/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>

                            <!-- Percentage Text -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding BatteryPercentageText}"
                                       FontSize="12" FontWeight="500"
                                       Foreground="{DynamicResource WindowForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding ShowPercentage, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Margin="0,0,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>