<Window x:Class="VoltDock.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VoltDock.App.Views"
        xmlns:vm="clr-namespace:VoltDock.App.ViewModels"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="VoltDock" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}"
        Style="{DynamicResource ModernWindowStyle}">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VoltDock.UI;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation Sidebar -->
        <Border Grid.Column="0" 
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Width="240">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Header -->
                <Border Grid.Row="0" Padding="20,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/VoltDock.App;component/Properties/app.ico" 
                               Width="32" Height="32" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="VoltDock" 
                                       FontSize="18" FontWeight="600"
                                       Foreground="{DynamicResource WindowForegroundBrush}"/>
                            <TextBlock Text="Управление зарядом устройств" 
                                       FontSize="11" Opacity="0.7"
                                       Foreground="{DynamicResource WindowForegroundBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,12">
                    <StackPanel>
                        <ToggleButton Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                Style="{DynamicResource NavButtonStyle}"
                                IsChecked="{Binding IsDashboardSelected, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Margin="12,10">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Обзор" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton Command="{Binding NavigateCommand}" CommandParameter="Devices"
                                Style="{DynamicResource NavButtonStyle}"
                                IsChecked="{Binding IsDevicesSelected, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Margin="12,10">
                                <TextBlock Text="&#xE94E;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Устройства" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton Command="{Binding NavigateCommand}" CommandParameter="Dock"
                                Style="{DynamicResource NavButtonStyle}"
                                IsChecked="{Binding IsDockSelected, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Margin="12,10">
                                <TextBlock Text="&#xE7B4;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Док" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton Command="{Binding NavigateCommand}" CommandParameter="Notifications"
                                Style="{DynamicResource NavButtonStyle}"
                                IsChecked="{Binding IsNotificationsSelected, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Margin="12,10">
                                <TextBlock Text="&#xE7B4;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Уведомления" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton Command="{Binding NavigateCommand}" CommandParameter="Appearance"
                                Style="{DynamicResource NavButtonStyle}"
                                IsChecked="{Binding IsAppearanceSelected, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Margin="12,10">
                                <TextBlock Text="&#xE771;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Внешний вид" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton Command="{Binding NavigateCommand}" CommandParameter="Advanced"
                                Style="{DynamicResource NavButtonStyle}"
                                IsChecked="{Binding IsAdvancedSelected, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Margin="12,10">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Дополнительно" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <ToggleButton Command="{Binding NavigateCommand}" CommandParameter="About"
                                Style="{DynamicResource NavButtonStyle}"
                                IsChecked="{Binding IsAboutSelected, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Margin="12,10">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="О программе" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- Version Info -->
                <Border Grid.Row="2" Padding="16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
                    <TextBlock Text="{Binding VersionText}" 
                               FontSize="11" Opacity="0.6"
                               Foreground="{DynamicResource WindowForegroundBrush}"
                               HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Border Grid.Column="1" Background="{DynamicResource ContentBackgroundBrush}">
            <ContentControl Content="{Binding CurrentView}" Margin="24"/>
        </Border>

        <!-- System Tray Icon -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="pack://application:,,,/VoltDock.App;component/Properties/app.ico"
                        ToolTipText="VoltDock - Мониторинг заряда устройств"
                        DoubleClickCommand="{Binding ShowWindowCommand}"
                        Visibility="Visible">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Показать окно" Command="{Binding ShowWindowCommand}"/>
                    <MenuItem Header="Показать/скрыть док" Command="{Binding ToggleDockCommand}"/>
                    <MenuItem Header="Обновить устройства" Command="{Binding RefreshDevicesCommand}"/>
                    <Separator/>
                    <MenuItem Header="Настройки" Command="{Binding OpenSettingsCommand}"/>
                    <Separator/>
                    <MenuItem Header="Выход" Command="{Binding ExitCommand}"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>