<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Minimal Theme - Clean, flat, no shadows or blur -->
    
    <Color x:Key="PrimaryColor">#000000</Color>
    <Color x:Key="PrimaryDarkColor">#333333</Color>
    <Color x:Key="PrimaryLightColor">#666666</Color>
    <Color x:Key="AccentColor">#000000</Color>
    <Color x:Key="BackgroundColor">#FFFFFF</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceLightColor">#F5F5F5</Color>
    <Color x:Key="BorderColor">#E0E0E0</Color>
    <Color x:Key="TextPrimaryColor">#000000</Color>
    <Color x:Key="TextSecondaryColor">#666666</Color>
    <Color x:Key="TextDisabledColor">#999999</Color>
    <Color x:Key="ErrorColor">#E53935</Color>
    <Color x:Key="WarningColor">#F57F17</Color>
    <Color x:Key="SuccessColor">#43A047</Color>
    <Color x:Key="InfoColor">#1E88E5</Color>

    <!-- Minimal Brushes -->
    <SolidColorBrush x:Key="DockBackgroundBrush" Color="#FFFFFF" Opacity="1"/>
    <SolidColorBrush x:Key="DockBorderBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="DeviceItemBackgroundBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="DeviceItemBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="BatteryTrackBrush" Color="#E0E0E0"/>

    <!-- No Shadows -->
    <DropShadowEffect x:Key="DockShadowEffect" 
                      BlurRadius="0" 
                      ShadowDepth="0" 
                      Opacity="0" 
                      Color="#000000"/>
    <DropShadowEffect x:Key="CardShadowEffect" 
                      BlurRadius="0" 
                      ShadowDepth="0" 
                      Opacity="0" 
                      Color="#000000"/>
    <DropShadowEffect x:Key="PopupShadowEffect" 
                      BlurRadius="0" 
                      ShadowDepth="0" 
                      Opacity="0" 
                      Color="#000000"/>

    <!-- Sharp Corners -->
    <CornerRadius x:Key="SmallCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="MediumCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="LargeCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="ExtraLargeCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="FullCornerRadius">0</CornerRadius>

    <!-- Minimal Button - No hover effects, just text -->
    <Style x:Key="ModernButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Minimal Nav Button -->
    <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,8"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Minimal TextBox - Bottom border only -->
    <Style x:Key="ModernTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,8,0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Minimal ComboBox -->
    <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource ModernComboBoxStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!-- Minimal Toggle - Simple checkbox style -->
    <Style x:Key="ModernToggleStyle" TargetType="CheckBox" BasedOn="{StaticResource ModernToggleStyle}">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Cursor="Hand">
                        <Border x:Name="Box"
                                Width="18" Height="18"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <Path x:Name="Check"
                                  Data="M0,0 L6,6 L14,-2"
                                  Stroke="{StaticResource PrimaryBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Width="12" Height="12"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Minimal Card - No shadow, subtle border -->
    <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>

    <!-- Minimal ScrollBar -->
    <Style x:Key="ModernScrollBarStyle" TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBarStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Width="4">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Border Background="{StaticResource BorderBrush}"
                                                CornerRadius="2"
                                                Margin="0"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>