<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Midnight Theme - Deep blue/purple dark theme -->
    
    <Color x:Key="PrimaryColor">#7C4DFF</Color>
    <Color x:Key="PrimaryDarkColor">#651FFF</Color>
    <Color x:Key="PrimaryLightColor">#B388FF</Color>
    <Color x:Key="AccentColor">#00E5FF</Color>
    <Color x:Key="BackgroundColor">#0A0E1A</Color>
    <Color x:Key="SurfaceColor">#12182B</Color>
    <Color x:Key="SurfaceLightColor">#1A2238</Color>
    <Color x:Key="BorderColor">#1E2A4A</Color>
    <Color x:Key="TextPrimaryColor">#E8EAED</Color>
    <Color x:Key="TextSecondaryColor">#8A94A8</Color>
    <Color x:Key="TextDisabledColor">#5A6478</Color>

    <!-- Midnight Brushes -->
    <SolidColorBrush x:Key="DockBackgroundBrush" Color="#12182B" Opacity="0.95"/>
    <SolidColorBrush x:Key="DockBorderBrush" Color="#1E2A4A"/>
    <SolidColorBrush x:Key="DeviceItemBackgroundBrush" Color="#1A2238" Opacity="0.95"/>
    <SolidColorBrush x:Key="DeviceItemBorderBrush" Color="#1E2A4A"/>
    <SolidColorBrush x:Key="BatteryTrackBrush" Color="#1E2A4A"/>
    <SolidColorBrush x:Key="BatteryLowBrush" Color="#FF5252"/>
    <SolidColorBrush x:Key="BatteryMediumBrush" Color="#FFD600"/>
    <SolidColorBrush x:Key="BatteryHighBrush" Color="#00E676"/>
    <SolidColorBrush x:Key="BatteryUnknownBrush" Color="#5A6478"/>

    <!-- Shadows -->
    <DropShadowEffect x:Key="DockShadowEffect" 
                      BlurRadius="25" 
                      ShadowDepth="0" 
                      Opacity="0.5" 
                      Color="#000000"/>
    <DropShadowEffect x:Key="CardShadowEffect" 
                      BlurRadius="15" 
                      ShadowDepth="3" 
                      Opacity="0.3" 
                      Color="#000000"/>

</ResourceDictionary>