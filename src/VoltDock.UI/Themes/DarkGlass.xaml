<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Dark Glass Theme - Based on Generic with glassmorphism -->
    
    <Color x:Key="BackgroundColor">#0D0D0D</Color>
    <Color x:Key="SurfaceColor">#1A1A2E</Color>
    <Color x:Key="SurfaceLightColor">#252540</Color>
    <Color x:Key="BorderColor">#2D2D50</Color>
    <Color x:Key="GlassBackgroundColor">#1A1A2E</Color>
    <Color x:Key="GlassBorderColor">#3D3D60</Color>

    <!-- Glass Brushes -->
    <SolidColorBrush x:Key="DockBackgroundBrush" Color="#1A1A2E" Opacity="0.85"/>
    <SolidColorBrush x:Key="DockBorderBrush" Color="#3D3D60"/>
    <SolidColorBrush x:Key="DeviceItemBackgroundBrush" Color="#252540" Opacity="0.9"/>
    <SolidColorBrush x:Key="DeviceItemBorderBrush" Color="#3D3D60"/>

    <!-- Enhanced Shadows -->
    <DropShadowEffect x:Key="DockShadowEffect" 
                      BlurRadius="30" 
                      ShadowDepth="0" 
                      Opacity="0.4" 
                      Color="#000000"/>
    <DropShadowEffect x:Key="CardShadowEffect" 
                      BlurRadius="20" 
                      ShadowDepth="4" 
                      Opacity="0.25" 
                      Color="#000000"/>

    <!-- Glass Window Chrome -->
    <Style x:Key="ModernWindowStyle" TargetType="Window" BasedOn="{StaticResource ModernWindowStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="32"
                              ResizeBorderThickness="8"
                              CornerRadius="12"
                              GlassFrameThickness="1"
                              UseAeroGlass="True"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glass Card -->
    <Style x:Key="GlassCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="#1A1A2E"/>
        <Setter Property="Opacity" Value="0.9"/>
        <Setter Property="BorderBrush" Value="#3D3D60"/>
    </Style>

</ResourceDictionary>