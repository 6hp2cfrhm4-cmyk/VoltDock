<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Light Glass Theme -->
    
    <Color x:Key="BackgroundColor">#F3F3F3</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceLightColor">#F5F5F5</Color>
    <Color x:Key="BorderColor">#E0E0E0</Color>
    <Color x:Key="TextPrimaryColor">#1A1A1A</Color>
    <Color x:Key="TextSecondaryColor">#666666</Color>
    <Color x:Key="TextDisabledColor">#999999</Color>

    <!-- Glass Brushes -->
    <SolidColorBrush x:Key="DockBackgroundBrush" Color="#FFFFFF" Opacity="0.9"/>
    <SolidColorBrush x:Key="DockBorderBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="DeviceItemBackgroundBrush" Color="#F5F5F5" Opacity="0.95"/>
    <SolidColorBrush x:Key="DeviceItemBorderBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="BatteryTrackBrush" Color="#E0E0E0"/>

    <!-- Shadows -->
    <DropShadowEffect x:Key="DockShadowEffect" 
                      BlurRadius="20" 
                      ShadowDepth="0" 
                      Opacity="0.15" 
                      Color="#000000"/>
    <DropShadowEffect x:Key="CardShadowEffect" 
                      BlurRadius="10" 
                      ShadowDepth="2" 
                      Opacity="0.1" 
                      Color="#000000"/>

</ResourceDictionary>